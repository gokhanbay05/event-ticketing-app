<%- include('partials/header') %>
<%- include('partials/navbar') %>
<body class="bg-gray-100">

  <div class="bg-primary-50">
    <div class="max-w-7xl mx-auto py-24 px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
        <span class="block">Your Gateway to</span>
        <span class="block text-primary-600">Amazing Events</span>
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-gray-600 sm:text-xl">
        Discover, book, and enjoy the best events in town. Concerts, sports, theater and more at your fingertips.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="/events" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700">
          Browse Events
        </a>
      </div>
    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900">
          Featured Events
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-500">
          Check out these exciting upcoming events.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 sm:grid-cols-2">
        
        <% if (typeof events !== 'undefined' && events.length > 0) { %>
          <% events.forEach(event => { %>

            <div class="group flex flex-col bg-white rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
              <div class="relative">
                <a href="/events/details/<%= event._id %>" class="block">
                  <img class="h-56 w-full object-cover" src="<%= event.image %>" alt="<%= event.name %>">
                </a>
                <div class="absolute top-3 right-3 bg-black bg-opacity-60 text-white font-bold text-lg px-4 py-1 rounded-full backdrop-blur-sm">
                  $<%= event.price %>
                </div>
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 leading-tight group-hover:text-primary-600 transition-colors">
                    <a href="/events/details/<%= event._id %>"><%= event.name %></a>
                  </h3>
                  <div class="mt-3 text-sm text-gray-500 space-y-2">
                    <p class="flex items-center">
                      <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" /></svg>
                      <span><%= new Date(event.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric' }) %></span>
                    </p>
                    <p class="flex items-center">
                      <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
                      <span><%= event.venueID.name %></span>
                    </p>
                  </div>
                </div>
                <div class="mt-auto pt-4">
                  <a href="/events/details/<%= event._id %>" class="w-full text-center inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700">
                    Get Tickets
                  </a>
                </div>
              </div>
            </div>
            
          <% }) %>
        <% } else { %>
          <p class="col-span-full text-center text-gray-500">No featured events available at the moment.</p>
        <% } %>

      </div>

      <div class="mt-12 text-center">
        <a href="/events" class="text-base font-medium text-primary-600 hover:text-primary-800">
          View all events <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>
  </div>

  <div class="py-16 bg-gray-50"> <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900">
          Featured Venues
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-500">
          Explore our top locations for unforgettable live shows.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 sm:grid-cols-2">
        
        <% if (typeof venues !== 'undefined' && venues.length > 0) { %>
          <% venues.forEach(venue => { %>
            
            <div class="group flex flex-col bg-white rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
              <div class="relative">
                <a href="/venues/details/<%= venue._id %>" class="block">
                  <img class="h-56 w-full object-cover" src="<%= venue.image %>" alt="<%= venue.name %>">
                </a>
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 leading-tight group-hover:text-primary-600 transition-colors">
                    <a href="/venues/details/<%= venue._id %>"><%= venue.name %></a>
                  </h3>
                  <div class="mt-3 text-sm text-gray-500 space-y-2">
                    <p class="flex items-center">
                      <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
                      <span><%= venue.address %></span>
                    </p>
                  </div>
                </div>
                <div class="mt-auto pt-4">
                  <a href="/venues/details/<%= venue._id %>" class="w-full text-center inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700">
                    View Events at this Venue
                  </a>
                </div>
              </div>
            </div>
            
          <% }) %>
        <% } else { %>
          <p class="col-span-full text-center text-gray-500">No featured venues available at the moment.</p>
        <% } %>
      </div>

      <div class="mt-12 text-center">
        <a href="/venues" class="text-base font-medium text-primary-600 hover:text-primary-800">
          View all venues <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>