<%- include('partials/header') %>
<%- include('partials/navbar') %>
<body class="bg-white">

  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    
    <div class="lg:grid lg:grid-cols-3 lg:gap-12 lg:items-start">

      <div class="lg:col-span-2 relative">

        <img 
          class="w-full h-auto object-cover rounded-xl shadow-2xl" 
          src="<%= venue.image %>" 
          alt="<%= venue.name %>"
        >

        <div class="mt-6 bg-gray-50 border border-gray-200 rounded-xl p-6 shadow">
          <h1 class="text-3xl font-bold text-gray-900"><%= venue.name %></h1>
          <div class="mt-3 flex flex-col sm:flex-row sm:items-center sm:space-x-6 text-gray-600">
            <p class="flex items-center">
              <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
              <span><%= venue.address %></span>
            </p>
            <p class="flex items-center mt-2 sm:mt-0">
              <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0110 11a5 5 0 01-1.5 3.67A6.97 6.97 0 007 16c0 .34.024.673.07 1h5.86zM6 16a7 7 0 00-5.93 4H2.07A8.963 8.963 0 0110 14c2.9 0 5.5.14 7.93 4h-4.04A7 7 0 006 16z" /></svg>
              <span><%= venue.capacity %> Person Capacity</span>
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-1 mt-10 lg:mt-0">
        <h2 class="text-2xl font-bold text-gray-900">Upcoming Events Here</h2>
        
        <% if (events.length > 0) { %>
          <div class="mt-4 max-h-[32rem] overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-gray-400 scrollbar-track-gray-100">
            <div class="space-y-4">
              <% events.forEach(event => { %>
                <a href="/events/details/<%= event._id %>" class="group flex items-center space-x-4 bg-gray-50 p-3 rounded-lg border border-gray-200 hover:shadow-md transition-all">
                  <div class="flex-shrink-0">
                    <img class="h-16 w-16 object-cover rounded-md" src="<%= event.image %>" alt="<%= event.name %>">
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-gray-800 group-hover:text-primary-700 truncate"><%= event.name %></h4>
                    <p class="text-sm text-gray-500 mt-1">
                      <%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </p>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <div class="mt-4 text-center border-2 border-dashed border-gray-300 rounded-lg p-8 text-gray-500">
            No upcoming events yet.
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>
</body> 
</html>
