<%- include('partials/header') %>
<%- include('partials/navbar') %>
<body class="bg-gray-50">

  <div class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          <%= title %>
        </h2>
        <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">
          Browse our collection of concerts, sports, and theater shows.
        </p>
      </div>

      <div class="mt-10 max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
        </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 sm:grid-cols-2 xl:grid-cols-4">

        <% events.forEach(event => { %>
        
        <div class="group flex flex-col bg-white rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          
          <div class="relative">
            <a href="/events/details/<%= event.id %>" class="block">
              <img class="h-56 w-full object-cover" src="<%= event.image %>" alt="<%= event.name %>">
            </a>
            <div class="absolute top-3 right-3 bg-black bg-opacity-60 text-white font-bold text-lg px-4 py-1 rounded-full backdrop-blur-sm">
              $<%= event.price %>
            </div>
          </div>
          
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex-1">
              <% if (event.category) { %>
                <p class="text-xs font-semibold text-primary-700 bg-primary-100 uppercase inline-block px-2 py-1 rounded-md mb-2">
                  <%= event.category %>
                </p>
              <% } %>
              
              <h3 class="text-xl font-bold text-gray-900 leading-tight group-hover:text-primary-600 transition-colors">
                <a href="/events/details/<%= event.id %>"><%= event.name %></a>
              </h3>

              <div class="mt-3 text-sm text-gray-500 space-y-2">
                <p class="flex items-center">
                  <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                  </svg>
                  <span><%= new Date(event.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                </p>
                <p class="flex items-center">
                  <svg class="flex-shrink-0 mr-2 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                  </svg>
                  <span><%= event.venueID.name %></span>
                </p>
              </div>
            </div>

            <div class="mt-auto pt-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <a href="/events/edit/<%= event.id %>" class="text-sm font-medium text-gray-500 hover:text-primary-600 transition-colors">Edit</a>
                    <a href="/events/delete/<%= event.id %>" class="text-sm font-medium text-red-500 hover:text-red-700 transition-colors">Delete</a>
                  <% } %>
                </div>
                <a href="/events/details/<%= event.id %>" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                  Get Tickets
                </a>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
  
  </div> 
    <%- include('partials/pagination', { 
      baseUrl: '/events', 
      currentPage: currentPage, 
      totalPages: totalPages 
    }) %>
  </div>

  <%- include('partials/footer') %>
</body>
</html>